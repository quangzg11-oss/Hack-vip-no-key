task.spawn(function()
	local restRemote = RepStorage.Remotes.Character.Rest
	local isRestingActive = false
	while true do
		task.wait(0.3)
		local shouldRest = _G.AutoRestRunning and (_G.CurrentQuest == "Rest")
		if shouldRest ~= isRestingActive then
			pcall(function() restRemote:InvokeServer(shouldRest) end)
			isRestingActive = shouldRest
		end
	end
end)
