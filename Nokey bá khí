task.spawn(function()
	while true do
		if _G.AutoZoneRunning then
			local hrp = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				for i, zone in ipairs(ZonesList) do
					if not _G.AutoZoneRunning then break end
					if IsThisZoneGreen(zone.Position) then
						ZoneButton.Text = "Zone " .. i .. " Owned"
						task.wait(0.05)
					else
						hrp.CFrame = zone.Teleport
						task.wait(0.05)
						local startTime = tick()
						while _G.AutoZoneRunning and not IsThisZoneGreen(zone.Position) and (tick() - startTime < 15) do
							hrp.CFrame = zone.Teleport * CFrame.new(math.sin(tick() * 8) * 0.35, 0, math.cos(tick() * 8) * 0.35)
							hrp.Velocity = Vector3.new(0, 0, 0)
							ZoneButton.Text = "Zone " .. i .. " Capturing..."
							task.wait(0.02)
						end
						ZoneButton.Text = "Zone " .. i .. " Captured!"
						task.wait(0.5)
					end
				end
				if hrp and _G.AutoZoneRunning then hrp.CFrame = CFrame.new(1449.99, 82.16, -677.59) end
				ZoneButton.Text = "Waiting (5s)..."
				task.wait(5)
			else task.wait(0.5) end
		else task.wait(0.1) end
	end
end)

task.spawn(function()
	while task.wait(0.2) do
		pcall(function()
			local questsFrame = Plr:WaitForChild("PlayerGui"):FindFirstChild("GameUI") and Plr.PlayerGui.GameUI:FindFirstChild("QuestsFrame")
			local detectedQuest = "None"
			if questsFrame then
				for _, child in pairs(questsFrame:GetChildren()) do
					local textContent = ""
					for _, desc in pairs(child:GetDescendants()) do
						if desc:IsA("TextLabel") then textContent = textContent .. " " .. string.lower(desc.Text) end
					end
					if string.find(textContent, "eat something") then detectedQuest = "Eat" break
					elseif string.find(textContent, "drink water") then detectedQuest = "Drink" break
					elseif string.find(textContent, "rest") then detectedQuest = "Rest" break end
				end
			end
			_G.CurrentQuest = detectedQuest
			
			local colors = { Eat = Color3.fromRGB(50, 255, 50), Drink = Color3.fromRGB(50, 150, 255), Rest = Color3.fromRGB(255, 165, 0) }
			QuestLabel.Text = "Current Quest: " .. (detectedQuest == "None" and "Waiting..." or detectedQuest)
			QuestLabel.TextColor3 = colors[detectedQuest] or Color3.fromRGB(255, 255, 0)
		end)
	end
end)

task.spawn(function()
	local remote = RepStorage.Remotes.Character.Eat
	while true do
		if _G.AutoEatRunning and _G.CurrentQuest == "Eat" then
			pcall(function()
				local hrp = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					local env = Workspace.MapEnvironment
					local closest, shortest = nil, math.huge
					local folders = {
						{ F = env:FindFirstChild("RedWood") and env.RedWood:FindFirstChild("Trees"), N = "RedWoodTree" },
						{ F = env:FindFirstChild("Pines") and env.Pines:FindFirstChild("Trees"), N = "PineTree" },
						{ F = env:FindFirstChild("Desert") and env.Desert:FindFirstChild("Tress"), N = "DesertTree" },
						{ F = env:FindFirstChild("Lobby") and env.Lobby:FindFirstChild("Trees"), N = "RedWoodTree" }
					}
					for _, conf in pairs(folders) do
						if conf.F then
							for _, tree in pairs(conf.F:GetChildren()) do
								if tree.Name == conf.N then
									local p = tree:IsA("BasePart") and tree or tree:FindFirstChildWhichIsA("BasePart")
									if p and (hrp.Position - p.Position).Magnitude < shortest then
										shortest, closest = (hrp.Position - p.Position).Magnitude, tree
									end
								end
							end
						end
					end
					if closest then remote:FireServer(closest) end
				end
			end)
			task.wait(0.4)
		else task.wait(0.2) end
	end
end)

